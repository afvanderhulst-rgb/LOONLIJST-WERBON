{
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }],
  "firestore": { "rules": "firestore-regels.txt" },
  "hosting": {
    "site": "mit-werkbon",
    "public": "dist",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/firebase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/beheer.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/kantoor.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
      { "source": "/kantoor.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
      { "source": "/lib/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
