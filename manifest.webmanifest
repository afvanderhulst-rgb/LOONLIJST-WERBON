{
 "name": "MIT Werkbonnen",
 "short_name": "MIT Werkbon",
 "description": "Digitale werkbonnen van MIT Installatietechniek",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#0b3fa8",
 "theme_color": "#0b3fa8",
 "lang": "nl",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "file",
     "accept": [
      "application/pdf",
      ".pdf"
     ]
    }
   ]
  }
 },
 "file_handlers": [
  {
   "action": "./index.html",
   "accept": {
    "application/pdf": [
     ".pdf"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 }
}