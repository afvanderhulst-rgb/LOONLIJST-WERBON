{
  "name": "MIT Werkbonnen",
  "short_name": "MIT Werkbon",
  "description": "Digitale werkbonnen van MIT Installatietechniek",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b3fa8",
  "theme_color": "#0b3fa8",
  "lang": "nl",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".webp"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "display_override": [
    "standalone"
  ],
  "id": "./index.html",
  "shortcuts": [
    {
      "name": "Nieuwe werkbon",
      "short_name": "Nieuwe bon",
      "url": "./?go=nieuw",
      "icons": [
        {
          "src": "sc-nieuw.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mijn planning",
      "short_name": "Planning",
      "url": "./?go=plan",
      "icons": [
        {
          "src": "sc-plan.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Weeklijst",
      "short_name": "Weeklijst",
      "url": "./?go=wl",
      "icons": [
        {
          "src": "sc-week.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
